{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "happyheartsoftware-site",
  "compatibility_date": "2026-10-04",
  // A static site. The Worker only redirects www to the bare domain;
  // .assetsignore keeps scripts and repo files from being served.
  "main": "worker/index.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // So www requests reach the Worker even when a file matches.
    "run_worker_first": true,
    // /privacy/quire serves privacy/quire.html, like GitHub Pages did.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "happyheartsoftware.com", "custom_domain": true },
    { "pattern": "www.happyheartsoftware.com", "custom_domain": true }
  ],
  "workers_dev": true,
  "preview_urls": true
}
